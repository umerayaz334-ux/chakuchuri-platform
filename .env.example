# Copy to .env and fill in secrets. Never commit the real .env file.

APP_ENV=development
HOST=0.0.0.0
PORT=8002
ALLOWED_ORIGIN=http://127.0.0.1:5170

# Required for real runs. JSON store is only for explicit local experiments.
DATABASE_URL=postgres://chakuchuri:CHANGE_ME@127.0.0.1:5432/chakuchuri?sslmode=disable
# Optional separate read-only backup role with permission to read every tenant.
# The app role must not be a superuser or bypass row-level security.
# BACKUP_DATABASE_URL=postgres://backup:CHANGE_ME@127.0.0.1:5432/chakuchuri?sslmode=disable
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=chakuchuri
POSTGRES_USER=chakuchuri
POSTGRES_PORT=5432

# Local Windows development is pinned to D: by scripts/run-api.ps1.
CC_LOCAL_DISK_ONLY=1
CC_LOCAL_DISK=D:

# Keep Postgres files outside the git/deploy folder (use another disk when possible).
# Example Windows: POSTGRES_DATA_DIR=E:/ChakuChuriData/postgres
POSTGRES_DATA_DIR=./.runtime/postgres

# File uploads — keep outside the deploy folder so a new build never wipes them.
STORAGE_DIR=./.runtime/storage

# Local cache of backup zips (can stay on the app machine).
BACKUP_DIR=./.runtime/backups

# Durable copy — another disk, NAS, or cloud-synced folder.
# Example Windows: BACKUP_OFFSITE_DIR=E:/ChakuChuriBackups
# Production refuses to start without this.
BACKUP_OFFSITE_DIR=
BACKUP_RETENTION=14
BACKUP_INTERVAL=24h

# Only for single-disk hosts that sync the offsite folder to cloud separately.
# BACKUP_ALLOW_SAME_VOLUME=1

# Local JSON-only development (forbidden in production). Prefer Postgres.
# CC_ALLOW_JSON_STORE=1

# WebRTC media (calls). STUN is enough on the same LAN; TURN is required across NATs/firewalls.
# CC_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
#
# Option A — static TURN credentials (Twilio/Metered-style long-lived user):
# CC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# CC_TURN_USERNAME=your-turn-user
# CC_TURN_CREDENTIAL=your-turn-password
#
# Option B — coturn time-limited credentials (preferred for self-hosted):
# CC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:443?transport=tcp
# CC_TURN_SHARED_SECRET=change-me-long-random
# CC_TURN_CREDENTIAL_TTL=86400
